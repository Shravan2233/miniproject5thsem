FLASK_DEBUG=0
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cabcompare
MYSQL_USER=cabcompare_app
MYSQL_PASSWORD=replace_with_a_local_password

# Add only after securing an approved mapping provider account.
MAPS_PROVIDER=
MAPS_API_KEY=
# Uber developer client ID; needed for the documented app-opening handoff.
UBER_CLIENT_ID=
# Ola-issued affiliate XAPP token; required for Ola's documented booking link.
OLA_XAPP_TOKEN=
